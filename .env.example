DATABASE_URL=postgresql://postgres:super_secret_password@localhost:5436/dis_ru
TOKEN=

# Register slash commands to these guilds only (instant). Comma separated.
# Leave unset to register globally, which covers every server the bot joins
# but takes up to an hour to propagate.
# The older singular GUILD_ID is still read if GUILD_IDS is unset.
GUILD_IDS=

# Optional. Both must be set to enable Spotify links.
# Create an app at https://developer.spotify.com/dashboard — no review needed.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional. Max tracks one album/playlist link may enqueue. Defaults to 100.
PLAYLIST_LIMIT=

# Optional. Playback needs yt-dlp. On startup the bot uses, in order:
#   1. YTDLP_PATH, if set — an existing yt-dlp binary to use as-is.
#   2. yt-dlp on PATH, if it runs.
#   3. a cached copy, downloaded from the yt-dlp GitHub release on first run
#      and verified against the published SHA2-256SUMS.
# The download lands in YTDLP_DIR, else $XDG_CACHE_HOME/dis-ru, else
# $HOME/.cache/dis-ru. Delete that file to pull a newer yt-dlp.
YTDLP_PATH=
YTDLP_DIR=
